# Large media files (keep locally, do not commit)
*.mp4
*.avi
*.mov
*.mkv
*.gif
*.webm

# Third-party reference clone (nested git history and large media)
samples/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

